name: ACV Official Spec Monitoring

on:
  schedule:
    # Run daily at 21:00 UTC (06:00 KST)
    - cron: '0 21 * * *'
  workflow_dispatch:
    inputs:
      update_baseline:
        description: 'Update snapshot baseline'
        required: false
        default: false
        type: boolean

jobs:
  monitor:
    name: Check Official Publisher Specifications
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install pyyaml

      - name: Run Spec Monitor
        id: run_monitor
        run: |
          if [ "${{ github.event.inputs.update_baseline }}" = "true" ]; then
            python scripts/monitor_specs.py --update-baseline
          else
            python scripts/monitor_specs.py
          fi

      - name: Check for Detected Changes
        id: check_changes
        run: |
          CHANGES_COUNT=$(python -c "import json; data=json.load(open('backend/data/detected_changes.json')); print(data.get('changes_count', 0))")
          echo "changes_count=$CHANGES_COUNT" >> $GITHUB_OUTPUT
          if [ "$CHANGES_COUNT" -gt 0 ]; then
            echo "Changes detected in official publisher guides!"
          else
            echo "All specifications are up to date."
          fi

      - name: Create Issue if Changes Detected
        if: steps.check_changes.outputs.changes_count > 0
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            const data = JSON.parse(fs.readFileSync('backend/data/detected_changes.json', 'utf8'));
            let body = `## 🚨 공식 매체 광고 가이드 변경 감지 알림\n\n`;
            body += `ACV 매체 공식 가이드 모니터링 엔진이 **${data.changes_count}개 매체**의 가이드라인 웹페이지 변경을 감지했습니다.\n\n`;
            body += `### 📋 변경 감지 매체 목록\n`;
            data.changes.forEach(c => {
              body += `- **${c.name}**\n  - 공식 가이드 URL: ${c.url}\n  - 감지 시각: ${c.detected_at}\n`;
            });
            body += `\n---\n*담당자는 해당 매체의 규격(해상도, 용량, 허용 확장자, 세이프존 등) 변경 여부를 확인한 후 규격 YAML을 업데이트해주세요.*`;
            
            await github.rest.issues.create({
              owner: context.repo.owner,
              repo: context.repo.repo,
              title: `[가이드 변경 감지] ${data.changes_count}개 매체 공식 가이드라인 개정 감지`,
              body: body,
              labels: ['spec-update', 'automated']
            });

      - name: Run Test Suite
        run: |
          cd backend
          python -m venv .venv
          .venv/bin/pip install -r requirements.txt pytest
          .venv/bin/pytest
